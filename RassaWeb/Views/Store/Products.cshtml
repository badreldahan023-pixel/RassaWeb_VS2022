@model List<RassaWeb.Models.Product>
@{
    ViewData["Title"] = "كتالوج المنتجات والبحث والتصفية";
    var categories = ViewBag.Categories as List<RassaWeb.Models.Category> ?? new List<RassaWeb.Models.Category>();
    var warehouses = ViewBag.Warehouses as List<RassaWeb.Models.Warehouse> ?? new List<RassaWeb.Models.Warehouse>();
    int? selectedCat = ViewBag.SelectedCategory;
    int? selectedWh = ViewBag.SelectedWarehouse;
    string? search = ViewBag.SearchQuery;
    string? sortBy = ViewBag.SortBy;
}

<div class="card-rassa p-4 mb-4">
    <h3 class="fw-bold text-rassa mb-3"><i class="bi bi-sliders me-2"></i>البحث وتصفية ومقارنة منتجات التوريد (@Model.Count منتج)</h3>
    <form method="get" asp-action="Products" class="row g-3">
        <div class="col-md-3">
            <label class="form-label small fw-bold">كلمة البحث</label>
            <input type="text" name="search" value="@search" class="form-control" placeholder="ابحث عن بن، أكواب، صوص، حليب..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold">القسم / التصنيف</label>
            <select name="categoryId" class="form-select">
                <option value="">جميع الأقسام (@categories.Count)</option>
                @foreach (var c in categories)
                {
                    if (selectedCat == c.CategoryID)
                    {
                        <option value="@c.CategoryID" selected>@c.CategoryName</option>
                    }
                    else
                    {
                        <option value="@c.CategoryID">@c.CategoryName</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold">المخزن المورّد</label>
            <select name="warehouseId" class="form-select">
                <option value="">جميع المخازن (@warehouses.Count)</option>
                @foreach (var w in warehouses)
                {
                    if (selectedWh == w.WarehouseID)
                    {
                        <option value="@w.WarehouseID" selected>@w.WarehouseName (@w.DistanceKm كم)</option>
                    }
                    else
                    {
                        <option value="@w.WarehouseID">@w.WarehouseName (@w.DistanceKm كم)</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold">ترتيب ومقارنة</label>
            <select name="sortBy" class="form-select">
                <option value="">الأحدث</option>
                @if (sortBy == "price_asc")
                {
                    <option value="price_asc" selected>السعر: الأقل أولاً</option>
                }
                else
                {
                    <option value="price_asc">السعر: الأقل أولاً</option>
                }
                @if (sortBy == "price_desc")
                {
                    <option value="price_desc" selected>السعر: الأعلى أولاً</option>
                }
                else
                {
                    <option value="price_desc">السعر: الأعلى أولاً</option>
                }
                @if (sortBy == "distance")
                {
                    <option value="distance" selected>المسافة: المخزن الأقرب</option>
                }
                else
                {
                    <option value="distance">المسافة: المخزن الأقرب</option>
                }
            </select>
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button type="submit" class="btn btn-rassa w-100"><i class="bi bi-funnel-fill"></i></button>
        </div>
    </form>
</div>

<div class="row g-4">
    @foreach (var p in Model)
    {
        <div class="col-md-6 col-lg-4 col-xl-3">
            <div class="card-rassa p-3 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-rassa-soft"><i class="bi @p.CategoryIcon me-1"></i>@p.SizeUnit</span>
                        @if (p.AvailableQuantity > 10)
                        {
                            <span class="badge bg-success">متاح: @p.AvailableQuantity وحدة</span>
                        }
                        else if (p.AvailableQuantity > 0)
                        {
                            <span class="badge bg-warning text-dark">كمية محدودة: @p.AvailableQuantity</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">نفد المخزون</span>
                        }
                    </div>
                    <h5 class="fw-bold text-rassa mb-1">@p.ProductName</h5>
                    <p class="small text-muted mb-2">@p.Description</p>
                    <div class="p-2 rounded bg-light small mb-3">
                        <div class="fw-semibold text-dark"><i class="bi bi-shop text-rassa me-1"></i>@p.WarehouseName</div>
                        <div class="text-muted"><i class="bi bi-geo-alt me-1"></i>@p.WarehouseZone (@p.WarehouseDistanceKm كم)</div>
                        <div class="text-success"><i class="bi bi-clock me-1"></i>الاستلام: @p.ExpectedDeliveryTime</div>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between align-items-center border-top pt-2 mb-3">
                        <span class="small text-muted">سعر الوحدة:</span>
                        <span class="fs-4 fw-bold text-rassa">@p.Price.ToString("N2") <small class="fs-6">ج.م</small></span>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@p.ProductID" class="btn btn-outline-rassa w-50">
                            <i class="bi bi-eye"></i> التفاصيل
                        </a>
                        <form asp-action="AddToCart" method="post" class="w-50">
                            <input type="hidden" name="productId" value="@p.ProductID" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-rassa w-100" disabled="@(p.AvailableQuantity <= 0)">
                                <i class="bi bi-cart-plus"></i> للسلة
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
