@model RassaWeb.Models.Order
@{
    ViewData["Title"] = "تتبع الطلب وسجل Blockchain";
    string[] steps = new[] { "تم تأكيد الطلب", "المخزن يجهّز الطلب", "جاهز للاستلام", "في الطريق", "تم التسليم" };
    int currentStepIndex = Array.IndexOf(steps, Model?.OrderStatus ?? "تم تأكيد الطلب");
    if (currentStepIndex < 0) currentStepIndex = 0;
}

@if (Model == null)
{
    <div class="alert alert-warning">الطلب غير موجود.</div>
}
else
{
    <div class="card-rassa p-4 mb-4 border-top border-4 border-success">
        <div class="row align-items-center g-3">
            <div class="col-md-7">
                <span class="badge bg-rassa px-3 py-2 mb-2">تتبع لحظي لدورة التوريد</span>
                <h2 class="fw-bold text-rassa mb-1">طلب رقم #@Model.OrderNumber</h2>
                <p class="text-muted mb-1">
                    <strong>العميل:</strong> @Model.ClientName (@Model.ClientBusinessType) |
                    <strong>المخزن:</strong> @Model.WarehouseName
                </p>
                <p class="small text-secondary mb-0"><i class="bi bi-geo-alt me-1"></i>عنوان التسليم: @Model.DeliveryAddress</p>
            </div>
            <div class="col-md-5 text-md-end">
                <div class="p-3 rounded-3 bg-rassa-soft d-inline-block text-start">
                    <div class="small text-muted">الوصول المتوقع: <strong>@(Model.OrderStatus == "تم التسليم" ? "تم الاستلام بنجاح" : Model.EstimatedArrivalMinutes + " دقيقة")</strong></div>
                    <div class="fs-4 fw-bold text-rassa">الإجمالي: @Model.TotalAmount.ToString("N2") ج.م</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- مراحل تتبع الطلب (شريحة 6) -->
        <div class="col-lg-5">
            <div class="card-rassa p-4 h-100">
                <h4 class="fw-bold text-rassa mb-3"><i class="bi bi-signpost-split me-2"></i>مراحل تتبع الطلب</h4>
                <ul class="list-group list-group-flush mb-4">
                    @for (int i = 0; i < steps.Length; i++)
                    {
                        bool isDone = i <= currentStepIndex;
                        <li class="list-group-item d-flex align-items-center justify-content-between py-3 border-0">
                            <div class="d-flex align-items-center gap-3">
                                <span class="step-circle @(isDone ? "step-done" : "step-pending")">
                                    <i class="bi @(isDone ? "bi-check-lg" : "bi-clock")"></i>
                                </span>
                                <div>
                                    <h6 class="fw-bold mb-0 @(isDone ? "text-rassa" : "text-muted")">@steps[i]</h6>
                                    <small class="text-muted">@(isDone ? "تمت المرحلة وموثقة" : "في انتظار التحديث")</small>
                                </div>
                            </div>
                            @if (i == currentStepIndex)
                            {
                                <span class="badge bg-warning text-dark">المرحلة الحالية</span>
                            }
                        </li>
                    }
                </ul>

                <h5 class="fw-bold text-rassa mb-2 border-top pt-3">أصناف الطلب</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var item in Model.Items)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span><strong>@item.ProductName</strong> (@item.SizeUnit) × @item.Quantity</span>
                            <span class="fw-bold text-rassa">@item.SubTotal.ToString("N2") ج.م</span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- طبقة توثيق Blockchain (شريحة 7) -->
        <div class="col-lg-7">
            <div class="card-rassa p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h4 class="fw-bold text-rassa mb-1"><i class="bi bi-link-45deg me-1"></i>طبقة الثقة: سجل كتل Blockchain</h4>
                        <p class="small text-muted mb-0">توثيق غير قابل للتعديل لكل حدث يمر به الطلب (SHA-256 Hash Chain)</p>
                    </div>
                    @if (Model.IsChainValid)
                    {
                        <span class="badge bg-success px-3 py-2"><i class="bi bi-shield-fill-check me-1"></i>السلسلة سليمة 100% (Verified)</span>
                    }
                    else
                    {
                        <span class="badge bg-danger px-3 py-2">تنبيه: تم رصد تلاعب في السلسلة</span>
                    }
                </div>

                <div class="d-flex flex-column gap-3">
                    @foreach (var block in Model.LedgerBlocks)
                    {
                        <div class="p-3 rounded-3 border bg-light position-relative">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-rassa fs-6">كتلة 0@(block.BlockIndex) - @block.EventType</span>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>@block.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</small>
                            </div>
                            <p class="fw-semibold mb-2 text-dark">@block.EventDescription</p>
                            <div class="row g-2">
                                <div class="col-12">
                                    <span class="small text-muted d-block">Previous Block Hash:</span>
                                    <div class="hash-box">@block.PreviousHash</div>
                                </div>
                                <div class="col-12">
                                    <span class="small text-rassa fw-bold d-block">Current Block SHA-256 Hash:</span>
                                    <div class="hash-box text-success fw-bold">@block.CurrentHash</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
