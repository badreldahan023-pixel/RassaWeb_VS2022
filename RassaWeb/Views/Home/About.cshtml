@{
    ViewData["Title"] = "من نحن – رِصّة";
    var stats = ViewBag.Stats as RassaWeb.Models.DashboardStats;
}

<div class="hero-rassa mb-5">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-warning text-dark fw-bold px-3 py-2 mb-3">تعرف على منصتنا</span>
            <h1 class="display-5 fw-bold mb-3">من نحن – رِصّة | RASSA</h1>
            <p class="fs-5 mb-3 opacity-90">
                <strong>رِصّة</strong> منصة إلكترونية تهدف إلى تسهيل عملية التوريد والشراء للمطاعم والكافيهات، من خلال ربط أصحاب الأنشطة التجارية بالموردين والمخازن في مكان واحد.
            </p>
            <p class="fs-6 opacity-85 mb-0">
                نسعى إلى توفير تجربة سهلة وسريعة تساعد العملاء على الوصول إلى المنتجات التي يحتاجون إليها، ومقارنة الخيارات، وإتمام الطلبات بكل سهولة.
            </p>
        </div>
        <div class="col-lg-4 text-center mt-4 mt-lg-0">
            <div class="bg-white bg-opacity-10 p-4 rounded-4 border border-light border-opacity-25">
                <i class="bi bi-boxes display-1 text-warning"></i>
                <h4 class="fw-bold mt-2">رِصّة.. كل احتياجاتك في مكان واحد</h4>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="card-rassa p-4 h-100 border-top border-4 border-success">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-rassa-soft p-3 rounded-3 fs-3">
                    <i class="bi bi-eye-fill"></i>
                </div>
                <h3 class="fw-bold text-rassa mb-0">رؤيتنا</h3>
            </div>
            <p class="fs-5 text-secondary mb-0 leading-relaxed">
                أن نكون المنصة الرائدة في مجال التوريدات والمنتجات الخاصة بالمطاعم والكافيهات.
            </p>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card-rassa p-4 h-100 border-top border-4 border-warning">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-warning bg-opacity-25 text-dark p-3 rounded-3 fs-3">
                    <i class="bi bi-bullseye"></i>
                </div>
                <h3 class="fw-bold text-rassa mb-0">رسالتنا</h3>
            </div>
            <p class="fs-5 text-secondary mb-0 leading-relaxed">
                توفير وسيلة ذكية وموثوقة تربط بين الموردين والعملاء، وتساعد على توفير الوقت والجهد وتحسين تجربة الشراء.
            </p>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-lg-6">
        <div class="card-rassa p-4 h-100">
            <h3 class="fw-bold text-rassa mb-4"><i class="bi bi-check2-circle text-success me-2"></i>أهدافنا</h3>
            <ul class="list-group list-group-flush">
                <li class="list-group-item py-3 d-flex align-items-center gap-3 border-0 bg-transparent">
                    <span class="step-circle step-done">1</span>
                    <span class="fs-5 fw-semibold">تسهيل الوصول إلى الموردين والمخازن.</span>
                </li>
                <li class="list-group-item py-3 d-flex align-items-center gap-3 border-0 bg-transparent">
                    <span class="step-circle step-done">2</span>
                    <span class="fs-5 fw-semibold">توفير مجموعة متنوعة من المنتجات.</span>
                </li>
                <li class="list-group-item py-3 d-flex align-items-center gap-3 border-0 bg-transparent">
                    <span class="step-circle step-done">3</span>
                    <span class="fs-5 fw-semibold">تسهيل عمليات البحث والشراء.</span>
                </li>
                <li class="list-group-item py-3 d-flex align-items-center gap-3 border-0 bg-transparent">
                    <span class="step-circle step-done">4</span>
                    <span class="fs-5 fw-semibold">تحسين التواصل بين الموردين والعملاء.</span>
                </li>
                <li class="list-group-item py-3 d-flex align-items-center gap-3 border-0 bg-transparent">
                    <span class="step-circle step-done">5</span>
                    <span class="fs-5 fw-semibold">توفير تجربة استخدام بسيطة وآمنة.</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card-rassa p-4 h-100">
            <h3 class="fw-bold text-rassa mb-4"><i class="bi bi-Layers-fill text-warning me-2"></i>خدماتنا</h3>
            <div class="row g-3">
                <div class="col-12">
                    <div class="p-3 rounded-3 bg-light border d-flex align-items-center gap-3">
                        <i class="bi bi-grid-1x2-fill fs-3 text-rassa"></i>
                        <div>
                            <h6 class="fw-bold mb-1">عرض المنتجات والتصنيفات</h6>
                            <p class="small text-muted mb-0">كتالوج متكامل يشمل القهوة، الألبان، الصوصات، التغليف، الدقيق، والمجمدات.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="p-3 rounded-3 bg-light border d-flex align-items-center gap-3">
                        <i class="bi bi-geo-alt-fill fs-3 text-rassa"></i>
                        <div>
                            <h6 class="fw-bold mb-1">استعراض الموردين والمخازن</h6>
                            <p class="small text-muted mb-0">اكتشاف المخازن القريبة جغرافياً لتقليل زمن وتكلفة التوريد.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="p-3 rounded-3 bg-light border d-flex align-items-center gap-3">
                        <i class="bi bi-search fs-3 text-rassa"></i>
                        <div>
                            <h6 class="fw-bold mb-1">البحث عن المنتجات ومقارنتها</h6>
                            <p class="small text-muted mb-0">مقارنة شفافة للأسعار والأحجام والكميات المتاحة بين مختلف الموردين.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="p-3 rounded-3 bg-light border d-flex align-items-center gap-3">
                        <i class="bi bi-cart-check-fill fs-3 text-rassa"></i>
                        <div>
                            <h6 class="fw-bold mb-1">إضافة المنتجات إلى سلة المشتريات</h6>
                            <p class="small text-muted mb-0">إصدار أوامر التوريد بضغطة واحدة مع خصم آلي من المخزون.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="p-3 rounded-3 bg-light border d-flex align-items-center gap-3">
                        <i class="bi bi-shield-check fs-3 text-rassa"></i>
                        <div>
                            <h6 class="fw-bold mb-1">متابعة الطلبات وإدارتها</h6>
                            <p class="small text-muted mb-0">تتبع لحظي لمراحل الطلب مع التوثيق المشفر عبر طبقة Blockchain.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card-rassa p-5 text-center bg-rassa-soft border-0">
    <h2 class="fw-bold text-rassa mb-3">رِصّة.. كل احتياجاتك في مكان واحد.</h2>
    <p class="fs-5 text-muted mb-4">ابدأ الآن باستكشاف أكثر من @(stats?.TotalWarehouses ?? 10) مخازن معتمدة و@(stats?.TotalProducts ?? 32) منتج جملة جاهز للتوريد الفوري.</p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a asp-controller="Store" asp-action="Warehouses" class="btn btn-rassa btn-lg px-4">
            <i class="bi bi-shop me-2"></i> استعراض الموردين والمخازن
        </a>
        <a asp-controller="Store" asp-action="Products" class="btn btn-outline-rassa btn-lg px-4">
            <i class="bi bi-box-seam me-2"></i> تصفح كتالوج المنتجات
        </a>
    </div>
</div>
