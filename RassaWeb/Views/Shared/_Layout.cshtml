@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserID");
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName");
    var role = HttpContextAccessor.HttpContext?.Session.GetString("Role");
    var cartCount = HttpContextAccessor.HttpContext?.Session.GetInt32("CartCount") ?? 0;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - منصة رِصّة | RASSA</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-rassa py-3 sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-boxes fs-3 text-warning"></i>
                    <span>رِصّة | RASSA</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#rassaNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="rassaNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> الرئيسية
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle me-1"></i> من نحن
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Store" asp-action="Warehouses">
                                <i class="bi bi-geo-alt me-1"></i> المخازن القريبة
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Store" asp-action="Products">
                                <i class="bi bi-grid me-1"></i> المنتجات والتصنيفات
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Store" asp-action="Orders">
                                <i class="bi bi-truck me-1"></i> الطلبات وتتبع Blockchain
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" asp-controller="Warehouse" asp-action="Index">
                                <i class="bi bi-shop me-1"></i> لوحة المخزن
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-info fw-bold" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-shield-lock me-1"></i> لوحة المسؤول
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Store" asp-action="Cart" class="btn btn-warning fw-bold position-relative">
                            <i class="bi bi-cart3"></i> السلة
                            @if (cartCount > 0)
                            {
                                <span class="position-absolute top-0 start-0 translate-middle badge rounded-pill bg-danger">
                                    @cartCount
                                </span>
                            }
                        </a>

                        @if (userId.HasValue)
                        {
                            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-light btn-sm">
                                <i class="bi bi-person-check"></i> @fullName
                            </a>
                            <a asp-controller="Account" asp-action="Logout" class="btn btn-danger btn-sm">
                                <i class="bi bi-box-arrow-left"></i> خروج
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light">
                                <i class="bi bi-box-arrow-in-Left"></i> دخول
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-light text-rassa fw-bold">
                                <i class="bi bi-person-plus"></i> حساب جديد
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white py-4 mt-5">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-5">
                    <h5 class="fw-bold text-warning mb-2"><i class="bi bi-boxes me-2"></i>رِصّة | RASSA</h5>
                    <p class="small text-light opacity-75 mb-0">
                        منصة إلكترونية ذكية تهدف إلى تسهيل عملية التوريد والشراء للمطاعم والكافيهات والمخابز، من خلال ربط أصحاب الأنشطة التجارية بالموردين والمخازن في مكان واحد.
                    </p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold mb-2">روابط سريعة</h6>
                    <div class="d-flex flex-wrap gap-3 small">
                        <a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none">الرئيسية</a>
                        <a asp-controller="Home" asp-action="About" class="text-white text-decoration-none">من نحن</a>
                        <a asp-controller="Store" asp-action="Warehouses" class="text-white text-decoration-none">المخازن القريبة</a>
                        <a asp-controller="Store" asp-action="Products" class="text-white text-decoration-none">المنتجات</a>
                        <a asp-controller="Store" asp-action="Track" asp-route-id="1" class="text-white text-decoration-none">تتبع طلب #1258</a>
                    </div>
                </div>
                <div class="col-md-3 text-md-end">
                    <span class="badge bg-success mb-2"><i class="bi bi-link-45deg"></i> مدعوم بطبقة توثيق Blockchain</span>
                    <p class="small text-secondary mb-0">مشروع تخرج نظم معلومات الأعمال 2026</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
